<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alberto Servin — Backend Developer</title>
  <meta name="description" content="Portfolio de Alberto Servin, desarrollador backend con experiencia en Node.js, Python, Ruby on Rails y más.">
  <meta property="og:title" content="Alberto Servin — Backend Developer">
  <meta property="og:description" content="Desarrollador backend apasionado por construir soluciones reales con Node.js, Python y Rails.">
  <meta property="og:type" content="website">
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/typed.js@2.0.12"></script>
</head>
<body>
  <div class="cursor-dot" id="cursor-dot"></div>
  <div class="cursor-ring" id="cursor-ring"></div>

  <header>
    <span class="header-logo">albert<span>serv</span></span>

    <nav>
      <ul>
        <li><a href="#about">Sobre mí</a></li>
        <li><a href="#tech-stack">Stack</a></li>
        <li><a href="#experience">Experiencia</a></li>
        <li><a href="#education">Educación</a></li>
        <li><a href="#projects">Proyectos</a></li>
        <li><a href="#contact">Contacto</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <button id="dark-mode-toggle" aria-label="Cambiar tema">
        <i class="fa-solid fa-moon"></i>
      </button>
    </div>
  </header>

  <main>

    <%# ——— HERO ——— %>
    <section id="introduction" class="fade-in">
      <div class="hero-avatar-wrapper">
        <%= image_tag('albertserv.png', alt: 'Alberto Servin', class: 'hero-avatar') %>
      </div>

      <div class="learning-badge">
        <span class="badge-dot"></span>
        Actualmente aprendiendo: Docker avanzado &amp; CI/CD
      </div>

      <h1 class="hero-title">Hola, soy <span id="typed-name"></span></h1>
      <p class="hero-tagline">
        Desarrollador backend y co-fundador de Fluxo Web E.A.S. Construyo APIs, productos con IA
        y herramientas open source. Full time en mi empresa desde 2026.
      </p>

      <div class="stat-bar">
        <div class="stat-item">
          <span class="stat-number">4+</span>
          <span class="stat-label">Años exp.</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">3</span>
          <span class="stat-label">Empresas</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">12+</span>
          <span class="stat-label">Tecnologías</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">5+</span>
          <span class="stat-label">Proyectos</span>
        </div>
      </div>

      <div class="hero-links">
        <a href="https://github.com/Albertserv" class="hero-link" target="_blank" rel="noopener">
          <i class="fa-brands fa-github"></i> GitHub
        </a>
        <a href="https://linkedin.com/in/albertserv" class="hero-link" target="_blank" rel="noopener">
          <i class="fa-brands fa-linkedin"></i> LinkedIn
        </a>
        <a href="#contact" class="hero-link primary">
          <i class="fa-solid fa-envelope"></i> Contactar
        </a>
      </div>

      <div class="hero-terminal">
        <span class="t-prompt">~$</span>
        <span class="t-cmd"> npm install <span class="t-out">albertserv</span></span><br>
        <span class="t-out">✓ Backend Developer instalado correctamente</span><br>
        <span class="t-out">✓ Co-founder de Fluxo Web E.A.S.</span><br>
        <span class="t-prompt">~$</span> <span class="t-cursor"></span>
      </div>

      <div class="scroll-indicator" id="scroll-indicator">
        <div class="scroll-mouse">
          <div class="scroll-wheel"></div>
        </div>
        <span>Scroll</span>
      </div>
    </section>

    <%# ——— SOBRE MÍ ——— %>
    <section id="about" class="fade-in">
      <h2><i class="fa-solid fa-user" style="color:var(--accent)"></i> Sobre mí</h2>
      <div class="about-grid">
        <p>
          Ingeniero en Informática graduado en 2023 de la Universidad Privada Del Este, Ciudad Del Este.
          Trabajo construyendo APIs, sistemas de telemetría y automatizaciones en Python, Node.js y Rails.
          Me interesa entender los problemas de fondo antes de escribir una línea de código — y disfrutar
          el proceso de hacerlo bien.
        </p>
        <div class="about-meta">
          <div class="about-meta-item">
            <i class="fa-solid fa-location-dot"></i>
            <span>Ciudad Del Este, PY</span>
          </div>
          <div class="about-meta-item">
            <i class="fa-solid fa-circle" style="color:#4ade80; font-size:0.5rem"></i>
            <span><strong>Disponible</strong> para proyectos</span>
          </div>
          <div class="about-meta-item">
            <i class="fa-solid fa-language"></i>
            <span>Español · Inglés</span>
          </div>
          <div class="about-meta-item">
            <i class="fa-brands fa-github"></i>
            <a href="https://github.com/Albertserv" target="_blank" style="color:var(--accent)">github.com/Albertserv</a>
          </div>
        </div>
      </div>
    </section>

    <%# ——— TECH STACK ——— %>
    <section id="tech-stack" class="fade-in">
      <h2><i class="fa-solid fa-layer-group" style="color:var(--accent)"></i> Stack</h2>
      <ul class="tech-list">
        <% technologies = [
          { name: 'Python',     svg: 'python.svg',      level: 'Avanzado',     cls: 'level-advanced',     img_cls: '' },
          { name: 'Node.js',    svg: 'nodejs.svg',      level: 'Avanzado',     cls: 'level-advanced',     img_cls: '' },
          { name: 'Express',    svg: 'expressjs.svg',   level: 'Avanzado',     cls: 'level-advanced',     img_cls: 'logo-dark' },
          { name: 'HTML',       svg: 'html.svg',        level: 'Avanzado',     cls: 'level-advanced',     img_cls: '' },
          { name: 'React',      svg: 'reactjs.svg',     level: 'Avanzado',     cls: 'level-advanced',     img_cls: '' },
          { name: 'Rails',      svg: 'rubyonrails.svg', level: 'Intermedio',   cls: 'level-intermediate', img_cls: '' },
          { name: 'Ruby',       svg: 'ruby.svg',        level: 'Intermedio',   cls: 'level-intermediate', img_cls: '' },
          { name: 'JavaScript', svg: 'js.svg',          level: 'Intermedio',   cls: 'level-intermediate', img_cls: '' },
          { name: 'Tailwind',   svg: 'tailwind.svg',    level: 'Intermedio',   cls: 'level-intermediate', img_cls: '' },
          { name: 'MongoDB',    svg: 'mongodb.svg',     level: 'Intermedio',   cls: 'level-intermediate', img_cls: '' },
          { name: 'PostgreSQL', svg: 'pgsql.svg',       level: 'Intermedio',   cls: 'level-intermediate', img_cls: '' },
          { name: 'MariaDB',    svg: 'mariadb.svg',     level: 'Intermedio',   cls: 'level-intermediate', img_cls: '' },
          { name: 'Docker',     svg: 'docker.svg',      level: 'Intermedio',   cls: 'level-intermediate', img_cls: '' },
          { name: 'C# / .NET',  svg: 'dotnet.svg',      level: 'Intermedio',   cls: 'level-intermediate', img_cls: '' },
        ] %>
        <% technologies.each do |tech| %>
          <li>
            <div class="tech-tooltip <%= tech[:cls] %>"><%= tech[:level] %></div>
            <%= image_tag(tech[:svg], alt: "#{tech[:name]} logo", class: tech[:img_cls]) %>
            <span><%= tech[:name] %></span>
          </li>
        <% end %>
      </ul>
    </section>

    <%# ——— EXPERIENCIA ——— %>
    <section id="experience" class="fade-in">
      <h2><i class="fa-solid fa-briefcase" style="color:var(--accent)"></i> Experiencia</h2>
      <div class="timeline">

        <div class="timeline-item">
          <div class="timeline-dot"><i class="fa-solid fa-circle-dot"></i></div>
          <div class="timeline-content">
            <h3>Neotelecom S.A.</h3>
            <div class="timeline-role">Analista de Datos & Desarrollo Backend</div>
            <div class="timeline-period">Junio 2023 — Enero 2026</div>
            <ul>
              <li>Desarrollo de sistemas y APIs con Node.js y Express.js</li>
              <li>Azure Functions en Python y C# para procesamiento de datos</li>
              <li>Aplicaciones de escritorio y scripts de automatización en Python</li>
              <li>Backend con Python, Flask y Django</li>
            </ul>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"><i class="fa-solid fa-circle-dot"></i></div>
          <div class="timeline-content">
            <h3>Fusión Electromecánica</h3>
            <div class="timeline-role">Desarrollador — Sistema de Telemetría</div>
            <div class="timeline-period">Abril 2023 — Diciembre 2023</div>
            <ul>
              <li>Sistema de monitoreo con Node-RED, Grafana, InfluxDB y Docker</li>
              <li>Configuración de dispositivos IoT con protocolo MQTT</li>
            </ul>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"><i class="fa-solid fa-circle-dot"></i></div>
          <div class="timeline-content">
            <h3>Neotelecom S.A.</h3>
            <div class="timeline-role">Asistente de R.M.A.</div>
            <div class="timeline-period">Febrero 2023 — Junio 2023</div>
            <ul>
              <li>Testing y configuración de routers y equipos de red</li>
            </ul>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"><i class="fa-solid fa-circle-dot"></i></div>
          <div class="timeline-content">
            <h3>Fluxo Web E.A.S.</h3>
            <div class="timeline-role">Co-fundador & Desarrollador Principal</div>
            <div class="timeline-period">2021 — Actualidad · Full time desde Enero 2026</div>
            <ul>
              <li>Desarrollo y lanzamiento de productos web con IA</li>
              <li>Diseño de arquitectura y stack técnico de productos</li>
              <li>Gestión del equipo técnico y dirección de producto</li>
            </ul>
          </div>
        </div>

      </div>
    </section>

    <%# ——— EDUCACIÓN ——— %>
    <section id="education" class="fade-in">
      <h2><i class="fa-solid fa-graduation-cap" style="color:var(--accent)"></i> Educación</h2>
      <div class="timeline">

        <div class="timeline-item">
          <div class="timeline-dot"><i class="fa-solid fa-circle-dot"></i></div>
          <div class="timeline-content">
            <h3>Ingeniería en Informática</h3>
            <div class="timeline-role">Universidad Privada Del Este — Filial C.D.E.</div>
            <div class="timeline-period">2018 — 2023</div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"><i class="fa-solid fa-circle-dot"></i></div>
          <div class="timeline-content">
            <h3>Licenciatura en Análisis de Sistemas</h3>
            <div class="timeline-role">Universidad Privada Del Este — Filial C.D.E.</div>
            <div class="timeline-period">2018 — 2022</div>
          </div>
        </div>

      </div>
    </section>

    <%# ——— PROYECTOS ——— %>
    <section id="projects" class="fade-in">
      <h2><i class="fa-solid fa-code" style="color:var(--accent)"></i> Proyectos</h2>

      <% proyectos_destacados = [
        {
          titulo:      'Reckado',
          descripcion: 'App web gratuita para gestión de listas de compras inteligentes. Ayuda a organizar el presupuesto del supermercado y evitar compras impulsivas.',
          tags:        ['Web App', 'Finanzas', 'UX'],
          url:         'https://reckado.com',
          screen:      nil, logo: 'reckado-logo.png', icon: 'fa-cart-shopping', cat: 'web'
        },
        {
          titulo:      'MillonAI',
          descripcion: 'App paraguaya de finanzas personales potenciada por IA. Adaptada al entorno local: Guaraníes ₲, categorías como ANDE, IPS, combustible y billeteras del país.',
          tags:        ['IA', 'Finanzas', 'Paraguay'],
          url:         'https://millonai.com',
          screen:      'millonai-screen.png', logo: 'millonai-logo.svg', icon: 'fa-brain', cat: 'ia'
        },
        {
          titulo:      'Quiro AI',
          descripcion: 'Plataforma de bienestar personal asistida por IA. Genera Qbooks personalizados basados en Ikigai e identidad, con QCoach como asistente de mentoría personal.',
          tags:        ['IA', 'Bienestar', 'Generativo'],
          url:         'https://quiro-ai.com',
          screen:      nil, logo: 'quiro-ai-logo.svg', icon: 'fa-seedling', cat: 'ia'
        },
        {
          titulo:      'guarani-a-letras',
          descripcion: 'Librería open source para Node.js. Convierte números a texto formal en Guaraníes: 12345 → "DOCE MIL TRESCIENTOS CUARENTA Y CINCO GUARANÍES". Ideal para sistemas de facturación legal en Paraguay.',
          tags:        ['npm', 'Open Source', 'Node.js'],
          url:         'https://www.npmjs.com/package/guarani-a-letras',
          screen:      nil, logo: nil, icon: 'fa-cube', cat: 'oss'
        },
        {
          titulo:      'Glam Nails',
          descripcion: 'Sistema de gestión y reservas online para salón de belleza especializado en manicura. Reservas 24/7, confirmación al instante, sin llamadas.',
          tags:        ['SaaS', 'Reservas', 'Belleza'],
          url:         'https://glamnails.fluxoweb.xyz',
          screen:      'glamnails-screen.png', logo: nil, icon: 'fa-scissors', cat: 'saas'
        },
      ] %>

      <div class="proyectos-grid">
        <% proyectos_destacados.each do |p| %>
          <div class="proyecto-card" data-cat="<%= p[:cat] %>">
            <% if p[:screen] %>
              <%= image_tag p[:screen], class: 'proyecto-card-img', alt: p[:titulo] %>
            <% else %>
              <div class="proyecto-card-img-placeholder">
                <% if p[:logo] %>
                  <%= image_tag p[:logo], alt: "#{p[:titulo]} logo", class: 'proyecto-logo-img' %>
                <% else %>
                  <i class="fa-solid <%= p[:icon] %>"></i>
                <% end %>
              </div>
            <% end %>
            <div class="proyecto-card-body">
              <h3><%= p[:titulo] %></h3>
              <p><%= p[:descripcion] %></p>
              <div class="proyecto-tags">
                <% p[:tags].each do |tag| %>
                  <span class="proyecto-tag"><%= tag %></span>
                <% end %>
              </div>
              <div class="proyecto-links">
                <a href="<%= p[:url] %>" target="_blank" rel="noopener" class="proyecto-link-btn primary">
                  <i class="fa-solid fa-arrow-up-right-from-square"></i> Ver proyecto
                </a>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @proyectos.any? %>
        <%# Proyectos adicionales de la BD se pueden mostrar acá en el futuro %>
      <% end %>
    </section>

    <%# ——— CONTACTO ——— %>
    <section id="contact" class="fade-in">
      <h2><i class="fa-solid fa-paper-plane" style="color:var(--accent)"></i> Contacto</h2>

      <% if notice %>
        <div class="flash flash-notice"><i class="fa-solid fa-circle-check"></i> <%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="flash flash-alert"><i class="fa-solid fa-triangle-exclamation"></i> <%= alert %></div>
      <% end %>

      <div class="contact-whatsapp-btns">
        <a href="https://wa.me/595975575157" target="_blank" rel="noopener" class="whatsapp-btn">
          <i class="fa-brands fa-whatsapp"></i> WhatsApp personal
        </a>
        <a href="https://wa.me/595973772673" target="_blank" rel="noopener" class="whatsapp-btn">
          <i class="fa-brands fa-whatsapp"></i> WhatsApp empresa
        </a>
      </div>

      <div class="contact-divider"><span>o enviame un mensaje</span></div>

      <%= form_with url: contact_path, method: :post, local: true, data: { turbo: false } do %>
        <div class="form-group">
          <label for="name">Nombre</label>
          <%= text_field_tag :name, nil, id: 'name', required: true, placeholder: 'Tu nombre' %>
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <%= email_field_tag :email, nil, id: 'email', required: true, placeholder: 'tu@email.com' %>
        </div>
        <div class="form-group">
          <label for="message">Mensaje</label>
          <%= text_area_tag :message, nil, id: 'message', required: true, placeholder: '¿En qué te puedo ayudar?' %>
        </div>
        <%= submit_tag 'Enviar mensaje', class: 'submit-button' %>
      <% end %>
    </section>

  </main>

  <footer>
    <p>Hecho por <a href="https://github.com/Albertserv" target="_blank">Alberto Servin</a> &mdash; <%= Date.today.year %></p>
  </footer>

  <script>
    // Dark mode con data-theme en html root — sin iterar elementos individuales
    const toggle = document.getElementById('dark-mode-toggle');
    const root = document.documentElement;
    const moonIcon = '<i class="fa-solid fa-moon"></i>';
    const sunIcon  = '<i class="fa-solid fa-sun"></i>';

    function applyTheme(theme) {
      root.setAttribute('data-theme', theme);
      toggle.innerHTML = theme === 'dark' ? sunIcon : moonIcon;
      localStorage.setItem('theme', theme);
    }

    const saved = localStorage.getItem('theme');
    const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    applyTheme(saved || preferred);

    toggle.addEventListener('click', () => {
      applyTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });

    // Typed.js
    document.addEventListener('DOMContentLoaded', function() {
      new Typed('#typed-name', {
        strings: ['Alberto Servin', 'Backend Developer', 'Problem Solver'],
        typeSpeed: 55,
        backSpeed: 30,
        backDelay: 2200,
        startDelay: 600,
        loop: true,
      });
    });

    // Header glassmorphism al scroll
    const header = document.querySelector('header');
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 10);
    }, { passive: true });

    // Nav activo con IntersectionObserver
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('nav ul li a');

    const navObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          navLinks.forEach(l => l.classList.remove('active'));
          const active = document.querySelector(`nav a[href="#${entry.target.id}"]`);
          if (active) active.classList.add('active');
        }
      });
    }, { threshold: 0.4 });

    sections.forEach(s => navObserver.observe(s));

    // Animaciones de entrada
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });

    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

    // Cursor personalizado
    const dot  = document.getElementById('cursor-dot');
    const ring = document.getElementById('cursor-ring');
    let ringX = 0, ringY = 0, dotX = 0, dotY = 0;

    document.addEventListener('mousemove', e => {
      dotX = e.clientX; dotY = e.clientY;
      dot.style.left  = dotX + 'px';
      dot.style.top   = dotY + 'px';
    });

    // El ring sigue con un lag suave
    function animateRing() {
      ringX += (dotX - ringX) * 0.12;
      ringY += (dotY - ringY) * 0.12;
      ring.style.left = ringX + 'px';
      ring.style.top  = ringY + 'px';
      requestAnimationFrame(animateRing);
    }
    animateRing();

    document.querySelectorAll('a, button, .tech-list li, .proyecto-card').forEach(el => {
      el.addEventListener('mouseenter', () => { dot.classList.add('hovering'); ring.classList.add('hovering'); });
      el.addEventListener('mouseleave', () => { dot.classList.remove('hovering'); ring.classList.remove('hovering'); });
    });

    // Ocultar cursor fuera de la ventana
    document.addEventListener('mouseleave', () => { dot.style.opacity = '0'; ring.style.opacity = '0'; });
    document.addEventListener('mouseenter', () => { dot.style.opacity = ''; ring.style.opacity = ''; });

    // Scroll indicator — desaparece al hacer scroll
    const scrollIndicator = document.getElementById('scroll-indicator');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 80) {
        scrollIndicator.classList.add('hidden');
      } else {
        scrollIndicator.classList.remove('hidden');
      }
    }, { passive: true });

    scrollIndicator.addEventListener('click', () => {
      document.getElementById('about').scrollIntoView({ behavior: 'smooth' });
    });
  </script>

</body>
</html>
