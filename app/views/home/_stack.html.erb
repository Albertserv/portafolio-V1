<%# Capítulo 2: la red se desarma en capas. Cada etiqueta (callout) señala una capa. %>
<section id="stack" class="chapter chapter--stack" aria-label="Stack">
  <div class="chapter-sticky">
    <div class="container stack-stage">
      <div class="stack-copy">
        <p class="eyebrow" data-reveal>Stack</p>
        <h2 class="section-title" data-split><%= split_words("Lo que *no ves,* capa por capa.") %></h2>
        <p class="stack-lead" data-reveal>
          Cada producto es una pila de capas. Trabajo en todas: desde la interfaz que tocás
          hasta la infraestructura que nadie ve.
        </p>
      </div>
    </div>

    <div class="callouts">
      <svg class="callout-lines" aria-hidden="true"></svg>
      <% capas.each_with_index do |c, l| %>
        <div class="callout <%= 'callout--visible' if c[:visible] %>" data-callout="<%= l %>">
          <p class="callout-name">
            <span><%= format("%02d", l + 1) %></span><%= c[:nombre] %>
            <em><%= c[:visible] ? "lo que ves" : "lo que no ves" %></em>
          </p>
          <ul class="callout-tech">
            <% c[:tecnologias].each do |t| %><li><%= t %></li><% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</section>
