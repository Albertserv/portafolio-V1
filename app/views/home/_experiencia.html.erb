<section id="experiencia" class="section experience" data-section="experience">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow" data-reveal>Experiencia</p>
      <h2 class="section-title" data-split><%= split_words("De configurar routers a *fundar* una empresa.") %></h2>
    </header>

    <ol class="timeline" data-timeline>
      <li class="timeline-line" aria-hidden="true"><span data-timeline-fill></span></li>
      <% experiencia.each do |e| %>
        <li class="tl-item <%= 'tl-item--edu' if e[:educacion] %>" data-tl-item>
          <span class="tl-dot" aria-hidden="true"></span>
          <p class="tl-period"><%= e[:periodo] %></p>
          <div class="tl-body">
            <h3><%= e[:lugar] %></h3>
            <p class="tl-role"><%= e[:rol] %><% if e[:nota] %> <span class="tl-note"><%= e[:nota] %></span><% end %></p>
            <% if e[:puntos].any? %>
              <ul>
                <% e[:puntos].each do |pt| %><li><%= pt %></li><% end %>
              </ul>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</section>
