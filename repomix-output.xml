    new Typed('#typed-name', {
      strings: ['Alberto Servin (>‿◠)✌', 'Web Designer (─‿‿─)', 'Entusiasta de la Tecnología (ɔ◔‿◔)ɔ ♥'],
      typeSpeed: 50,
      backSpeed: 25,
      backDelay: 2000,
      startDelay: 1000,
      loop: true
    });
  });
