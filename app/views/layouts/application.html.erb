<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#06070b">
  <title>Alberto Servin — Full Stack Developer</title>
  <meta name="description" content="Alberto Servin, Full Stack Developer y co-fundador de Fluxo Web. Productos con IA, APIs y apps web desde Ciudad del Este, Paraguay.">
  <meta property="og:title" content="Alberto Servin — Full Stack Developer">
  <meta property="og:description" content="Lo que ves y lo que no ves, lo construyo yo. Productos con IA, APIs y apps web desde Paraguay.">
  <meta property="og:type" content="website">
  <%= csrf_meta_tags %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "application", media: "all" %>

  <%# Oculta los elementos animables antes del primer pintado. Si el JS no carga en 4s, se muestran igual. %>
  <script>
    var html = document.documentElement;
    html.classList.add("js");
    // "story": la página como historia con escenarios fijos. Sin JS o con movimiento reducido, es una lista normal.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) html.classList.add("reduced");
    else html.classList.add("story");
    setTimeout(function () { if (!window.__motionReady) html.classList.remove("js", "story"); }, 4000);
  </script>
  <%= javascript_importmap_tags %>
</head>
<body>
  <canvas id="scene" aria-hidden="true"></canvas>
  <div class="scene-fade" aria-hidden="true"></div>
  <div id="node-labels" aria-hidden="true"></div>

  <%= render "shared/header" %>

  <main>
    <%= yield %>
  </main>

  <%= render "shared/footer" %>

  <%# Reglita de progreso del scroll (como en animejs.com) %>
  <div class="ruler" id="ruler" aria-hidden="true">
    <span class="ruler-label"><b data-ruler-num>01</b><span data-ruler-name>Inicio</span></span>
    <span class="ruler-ticks"><% 32.times do %><i></i><% end %><span class="ruler-mark" data-ruler-mark></span></span>
  </div>
</body>
</html>
